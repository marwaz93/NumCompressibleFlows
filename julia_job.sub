executable = run_julia.sh

request_cpus   = 1
request_memory = $(memory)

requirements = (TARGET.TotalGPUs == 0)

output = out/$(jobtype)_$(Process).out
log    = log/$(jobtype)_$(Process).log
error  = err/$(jobtype)_$(Process).err

arguments = $(arguments)

## jobtype = solve or plot selects the job list; set in study.dag, or by hand with
##   condor_submit -a "jobtype=solve" julia_job.sub
queue memory, arguments from parameters_$(jobtype).txt
